# PWA (nov 2026, Tarea 6). Los assets llevan hash en el nombre: se pueden
# cachear para siempre. El service worker, el manifest y el index NO: si el
# navegador se queda con un sw.js viejo, la app no se actualiza más.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/icons/*
  Cache-Control: public, max-age=604800

/sw.js
  Cache-Control: no-cache
  Service-Worker-Allowed: /

/manifest.webmanifest
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/
  Cache-Control: no-cache
